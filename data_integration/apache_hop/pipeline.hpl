  <transform>
    <type>Formula</type>
    <name>Formula</name>
    <formulas>
      <formula>
        <field_name>projected_points</field_name>
        <formula>([points] / [played_games]) * 38</formula>
        <value_type>1</value_type>
        <value_length>10</value_length>
        <value_precision>2</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>diff_champions_league</field_name>
        <formula>(([points] / [played_games]) * 38) - [target_champions_league]</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>2</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>diff_europa_league</field_name>
        <formula>(([points] / [played_games]) * 38) - [target_europa_league]</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>2</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>diff_relegation_safety</field_name>
        <formula>(([points] / [played_games]) * 38) - [target_relegation_safety]</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>2</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>efficiency_status</field_name>
        <formula>IF([diff_champions_league] >= 0, "UCL Pace", IF([diff_europa_league] >= 0, "UEL Pace", IF([diff_relegation_safety] &lt; 0, "Relegation Threat", "Mid-table Safety")))</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1216</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
