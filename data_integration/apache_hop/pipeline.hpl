  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling>
    <error>
      <source_transform>CSV Players</source_transform>
      <is_enabled>N</is_enabled>
      <nr_valuename/>
      <descriptions_valuename/>
      <fields_valuename/>
      <codes_valuename/>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>
