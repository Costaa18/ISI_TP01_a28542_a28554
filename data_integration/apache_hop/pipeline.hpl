    <name>Add constants</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>38</nullif>
        <name>total_games_season</name>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
