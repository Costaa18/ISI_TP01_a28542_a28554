      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>Y</remove>
    </calculation>
    <calculation>
      <field_name>projected_points</field_name>
      <calc_type>MULTIPLY</calc_type>
      <field_a>points_per_game</field_a>
      <field_b>total_games_season</field_b>
      <field_c/>
      <value_type>Number</value_type>
