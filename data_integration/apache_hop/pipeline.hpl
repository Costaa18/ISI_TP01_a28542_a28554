    <calculation>
      <field_name>cost_per_point</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>market_value_in_eur</field_a>
      <field_b>points</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <conversion_mask>#,##0.00</conversion_mask>
