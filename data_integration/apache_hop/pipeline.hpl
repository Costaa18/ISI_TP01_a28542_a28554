  <transform>
    <type>FilterRows</type>
    <name>Filter rows 2</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>points</leftvalue>
        <function>IS NOT NULL</function>
        <conditions/>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
